# How many seconds to wait for page loading and between retries
SLEEP_TIME=3
# How many retries before failing
RETRY_LIMIT=3
# true or false depending on if you're forcing a log in
FORCE_NEW_COOKIES=false 
# Set the the path to your cookies file
COOKIES_PATH=cookies.json
# Set to your chrome version if the default it too new
CHROME_VERSION=None
# true or false depending on if you want to run headless. If forcing cookies this will be overridden to be TRUE so you can login.
HEADLESS=false